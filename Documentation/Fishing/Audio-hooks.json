    },
    {
      "key": "ui_close",
      "status": "alias",
      "hook": "session_end",
      "default_file": "fishing/fishing_ui_close.wav",
      "detail_fr": "Fermeture normale : une lecture non bouclée après nettoyage."
    },
    {
