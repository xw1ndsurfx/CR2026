{
  "version": 1,
  "runtime_fields": [
    "File",
    "Volume",
    "Loop",
    "CooldownMs",
    "MaximumInstances",
    "Spatial",
    "Range"
  ],
  "metadata_only": [
    "bus",
    "pitch",
    "fade_duration",
    "manifest_gain_override"
  ],
  "reserved": [
    "challenge_timing_prompt",
    "challenge_reel_prompt"
