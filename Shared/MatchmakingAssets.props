<Project>
  <ItemGroup>
    <Content Include="$(MSBuildThisFileDirectory)..\Intersect.Client\resources\gui\matchmaking_*_v1.png">
      <Link>resources\gui\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
    <Content Include="$(MSBuildThisFileDirectory)..\Intersect.Client\resources\sounds\matchmaking\*_v1.wav">
      <Link>resources\sounds\matchmaking\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
  </ItemGroup>
</Project>
