<Project>
  <ItemGroup>
    <Content Include="$(MSBuildThisFileDirectory)..\Intersect.Client\resources\sounds\interface\*_v1.wav">
      <Link>resources\sounds\interface\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
  </ItemGroup>
</Project>
