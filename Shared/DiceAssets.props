<Project>
  <ItemGroup>
    <Content Include="$(MSBuildThisFileDirectory)../resources/gui/roll-the-dice/*.png">
      <Link>resources/gui/roll-the-dice/%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
  </ItemGroup>
</Project>
